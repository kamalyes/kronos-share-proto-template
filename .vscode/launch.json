  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run <% .OrgPrefix | pascal %> Share Service",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/bootstrap",
      "args": [],
      "windows": {
        "env": {
          "GOARCH": "amd64",
          "GOOS": "windows",
          "APP_ENV": "dev",
          "CGO_ENABLED": "0"
        }
      },
      "osx": {
        "env": {
          "GOARCH": "arm64",
          "GOOS": "darwin",
          "APP_ENV": "dev"
        }
      }
    }
  ]
}
